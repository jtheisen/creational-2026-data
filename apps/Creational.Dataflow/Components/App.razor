<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Creational dataflow</title>
    <link rel="stylesheet" href="/_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="/site.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <MudLayout>
        <MudAppBar Color="Color.Primary" Elevation="1" Dense="true">
            <MudText Typo="Typo.h6">Creational dataflow</MudText>
            <MudSpacer />
            <MudButton Href="/" Color="Color.Inherit">Collections</MudButton>
            <MudButton Href="/images" Color="Color.Inherit">Images</MudButton>
        </MudAppBar>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
                <Routes @rendermode="InteractiveServer" />
            </MudContainer>
        </MudMainContent>
    </MudLayout>
    <script src="/_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/_framework/blazor.web.js"></script>
</body>
</html>
