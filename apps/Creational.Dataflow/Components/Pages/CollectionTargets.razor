@page "/collections/enwiki-2026-10-01"
@implements IAsyncDisposable
@inject CollectionImportEngine Engine
@inject ImportCoordinator Coordinator
@inject Creational.Dataflow.Storage.ITargetRepository Repository
@inject Creational.Dataflow.Storage.ICollectionSettingsRepository Settings
@inject TransferLedger Ledger

<p><a href="/">← Collections</a></p>
<h1>English Wikipedia · 2026-10-01</h1>
<p>Mark an output group stale, inspect the resulting plan, then start the collection import. Image preview and import are planned but not yet available in this app.</p>

<div class="actions">
    <button type="button" @onclick="StartImport">Import collection</button>
    <button type="button" class="secondary" @onclick="Refresh">Refresh now</button>
</div>
<div class="actions">
    <label for="parallelism">Maximum concurrent targets</label>
    <input id="parallelism" type="number" min="1" max="@Creational.Dataflow.Execution.CollectionParallelism.Maximum" step="1" @bind="_parallelismDraft" />
    <button type="button" class="secondary" @onclick="SaveParallelism">Save limit</button>
    <span>Saved limit: @_savedParallelism</span>
</div>
<p>This limits simultaneous targets. Import collection can still run all due targets in sequence.</p>
@if (!string.IsNullOrEmpty(_message))
{
    <p class="notice" role="status">@_message</p>
}
@if (!string.IsNullOrEmpty(_error))
{
    <p class="error" role="alert">@_error</p>
}

@if (_snapshot is null)
{
    <p>Loading targets…</p>
}
else
{
    <div class="summary">
        @foreach (var item in Enum.GetValues<TargetDisposition>())
        {
            <div><strong>@_snapshot.Plan.Targets.Count(t => t.Disposition == item)</strong><span>@item</span></div>
        }
    </div>
    @if (Coordinator.Snapshots().Count > 0)
    {
        <section class="target-group">
            <h2>Import runs</h2>
            <table>
                <thead><tr><th>Run</th><th>State</th><th>Started</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var run in Coordinator.Snapshots().Take(5))
                    {
                        <tr>
                            <td>@run.RunId[..8]</td>
                            <td>
                                @if (run.State == "running")
                                {
                                    <span class="activity"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />@run.State</span>
                                }
                                else
                                {
                                    @run.State
                                }
                            </td>
                            <td>@run.StartedAt.ToLocalTime()</td><td>@run.Error</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
    <div class="actions" aria-live="polite">
        <span>@_selection.Count selected</span>
        @if (_selection.Count > 0)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="_selection.Clear" Disabled="_markingStale">Clear selection</MudButton>
        }
    </div>
    <MudExpansionPanels MultiExpansion="true" Dense="true" Elevation="0">
        @foreach (var group in CollectionPageModel.Groups(_snapshot.Plan))
        {
            var groupKind = group.Kind;
            var selectedInGroup = group.Targets.Count(t => _selection.Contains(t.Id));
            <MudExpansionPanel @key="groupKind" Expanded="_expandedGroups.Contains(groupKind)"
                               ExpandedChanged="@(expanded => SetExpanded(groupKind, expanded))">
                <TitleContent>
                    <span class="target-group-title">@groupKind <small>@group.Targets.Count targets</small>
                        @if (selectedInGroup > 0)
                        {
                            <small>· @selectedInGroup selected</small>
                        }
                    </span>
                </TitleContent>
                <ChildContent>
                    <div class="table-scroll">
                        <MudTable T="PlannedTarget" Items="group.Targets" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh>Select</MudTh><MudTh>Target</MudTh><MudTh>Plan</MudTh><MudTh>Reason</MudTh>
                                <MudTh>Last outcome</MudTh><MudTh>Output</MudTh><MudTh>Detail</MudTh><MudTh>Action</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="planned">
                                @{ _snapshot.States.TryGetValue(planned.Id, out var state); }
                                <MudTd>
                                    <MudCheckBox T="bool" Dense="true" AriaLabel="@($"Select {planned.Id}")"
                                                 Value="_selection.Contains(planned.Id)"
                                                 ValueChanged="@(selected => SetSelected(planned.Id, selected))" />
                                </MudTd>
                                <MudTd><strong>@planned.Id.Key</strong></MudTd>
                                <MudTd><span class="status @planned.Disposition.ToString().ToLowerInvariant()">@planned.Disposition</span></MudTd>
                                <MudTd>@planned.Reason</MudTd>
                                <MudTd>
                                    @if (state?.Outcome is "queued" or "launching" or "running")
                                    {
                                        <span class="activity"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />@state.Outcome</span>
                                    }
                                    else
                                    {
                                        @(state?.Outcome ?? "missing")
                                    }
                                </MudTd>
                                <MudTd>
                                    @if (state?.ManifestPath is { Length: > 0 } marker)
                                    {
                                        <a href="@marker" target="_blank" rel="noopener noreferrer">Output group</a>
                                    }
                                </MudTd>
                                <MudTd>@(state?.Error ?? state?.StaleReason ?? "")</MudTd>
                                <MudTd>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_markingStale"
                                               OnClick="@(() => MarkStale(planned.Id))">
                                        @(_selection.Count > 0 ? $"Mark {_selection.Count} selected stale" : "Mark stale")
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@if (Ledger.All().Count > 0)
{
    <section class="target-group">
        <h2>Live transfers</h2>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Target</th><th>State</th><th>Bytes</th><th>Expected bytes</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var transfer in Ledger.All())
                    {
                        <tr><td>@transfer.Target</td><td>@transfer.State</td><td>@transfer.Bytes.ToString("N0")</td>
                            <td>@transfer.ExpectedBytes?.ToString("N0")</td><td>@transfer.Error</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private CollectionPlanSnapshot? _snapshot;
    private string? _message;
    private string? _error;
    private int _parallelismDraft = Creational.Dataflow.Execution.CollectionParallelism.Default;
    private int _savedParallelism = Creational.Dataflow.Execution.CollectionParallelism.Default;
    private readonly TargetSelection _selection = new();
    private readonly HashSet<string> _expandedGroups = [];
    private bool _markingStale;
    private readonly CancellationTokenSource _refreshStop = new();
    private Task? _refreshTask;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _refreshTask = RefreshLoopAsync();
    }

    private async Task Refresh()
    {
        try
        {
            _snapshot = await Engine.GetRecordedPlanAsync(October2026Collection.Collection, _refreshStop.Token);
            var parallelism = await Settings.GetParallelismAsync(October2026Collection.Collection, _refreshStop.Token);
            if (_parallelismDraft == _savedParallelism) _parallelismDraft = parallelism;
            _savedParallelism = parallelism;
            _error = null;
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            _error = error.Message;
        }
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_refreshStop.Token))
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }

    private async Task MarkStale(TargetId id)
    {
        if (_markingStale) return;
        _markingStale = true;
        var targets = _selection.ActionTargets(id);
        var failures = new List<string>();
        var succeeded = 0;
        try
        {
            foreach (var target in targets)
            {
                try
                {
                    await Repository.MarkStaleAsync(target, "Marked in dashboard", _refreshStop.Token);
                    _selection.MarkSucceeded(target);
                    succeeded++;
                }
                catch (Exception error) when (error is not OperationCanceledException)
                {
                    failures.Add($"{target}: {error.Message}");
                }
            }
            _message = succeeded > 0 ? $"Marked {succeeded} target(s) stale. The plan below shows what would run." : null;
            await Refresh();
            if (failures.Count > 0) _error = $"Could not mark {failures.Count} target(s) stale: {string.Join("; ", failures)}";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _markingStale = false; }
    }

    private void SetSelected(TargetId id, bool selected) => _selection.Set(id, selected);

    private void SetExpanded(string kind, bool expanded)
    {
        if (expanded) _expandedGroups.Add(kind);
        else _expandedGroups.Remove(kind);
    }

    private async Task SaveParallelism()
    {
        try
        {
            await Settings.SetParallelismAsync(October2026Collection.Collection, _parallelismDraft, _refreshStop.Token);
            _savedParallelism = _parallelismDraft;
            _message = $"Maximum concurrent targets set to {_savedParallelism}.";
            _error = null;
        }
        catch (Exception error) { _error = error.Message; }
    }

    private async Task StartImport()
    {
        try
        {
            var run = await Coordinator.StartOrGetAsync(October2026Collection.Collection, CancellationToken.None);
            _message = $"Collection import started: {run}";
            await Refresh();
        }
        catch (Exception error) { _error = error.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        _refreshStop.Cancel();
        if (_refreshTask is not null) await _refreshTask;
        _refreshStop.Dispose();
    }
}
