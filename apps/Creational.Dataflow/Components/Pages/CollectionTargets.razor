@page "/collections/enwiki-2026-10-01"
@implements IAsyncDisposable
@inject CollectionImportEngine Engine
@inject ImportCoordinator Coordinator
@inject Creational.Dataflow.Storage.ITargetRepository Repository
@inject Creational.Dataflow.Storage.ICollectionSettingsRepository Settings
@inject TransferLedger Ledger

<MudStack Spacing="3">
<MudBreadcrumbs Items="_breadcrumbs" />
<MudText Typo="Typo.h4">English Wikipedia · 2026-10-01</MudText>
<MudText Color="Color.Secondary">Mark outputs stale, inspect the plan, or start a collection import. Image candidates can be explored in the separate preview.</MudText>
<MudStack Row="true" Spacing="2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartImport">Import collection</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="Refresh">Refresh now</MudButton>
    <MudButton Variant="Variant.Text" Href="/images">Preview images</MudButton>
</MudStack>
<MudPaper Class="pa-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudNumericField T="int" Label="Maximum concurrent targets" Min="1" Max="@Creational.Dataflow.Execution.CollectionParallelism.Maximum"
                         Variant="Variant.Outlined" @bind-Value="_parallelismDraft" />
        <MudButton Variant="Variant.Outlined" OnClick="SaveParallelism">Save limit</MudButton>
        <MudText Color="Color.Secondary">Saved limit: @_savedParallelism</MudText>
    </MudStack>
    <MudText Typo="Typo.caption">This limits simultaneous targets. Import collection can still run all due targets in sequence.</MudText>
</MudPaper>
@if (!string.IsNullOrEmpty(_message))
{
    <MudAlert Severity="Severity.Success">@_message</MudAlert>
}
@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}

@if (_snapshot is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" Spacing="2">
        @foreach (var item in Enum.GetValues<TargetDisposition>())
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5">@_snapshot.Plan.Targets.Count(t => t.Disposition == item)</MudText>
                <MudText Color="Color.Secondary">@item</MudText>
            </MudPaper>
        }
    </MudStack>
    @if (Coordinator.Snapshots().Count > 0)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Import runs</MudText>
            <div class="table-scroll">
                <MudTable T="ImportRunSnapshot" Items="Coordinator.Snapshots().Take(5)" Dense="true" Elevation="0">
                    <HeaderContent><MudTh>Run</MudTh><MudTh>State</MudTh><MudTh>Started</MudTh><MudTh>Detail</MudTh></HeaderContent>
                    <RowTemplate Context="run">
                        <MudTd>@run.RunId[..8]</MudTd>
                        <MudTd>
                            <span class="activity"><span class="activity-icon">
                                @if (run.State == "running")
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                }
                            </span>@run.State</span>
                        </MudTd>
                        <MudTd>@run.StartedAt.ToLocalTime()</MudTd><MudTd>@run.Error</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudPaper>
    }
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="target-toolbar">
        <MudText>@_selection.Count selected</MudText>
        @if (_selection.Count > 0)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="_selection.Clear" Disabled="_markingStale">Clear selection</MudButton>
        }
        <MudSpacer />
        <MudToggleGroup T="TargetListView" @bind-Value="_targetListView" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary" CheckMark="true" FixedContent="true" aria-label="Show targets">
            <MudToggleItem Value="TargetListView.All" Text="All" />
            <MudToggleItem Value="TargetListView.Working" Text="Working on" />
            <MudToggleItem Value="TargetListView.Groups" Text="Groups only" />
        </MudToggleGroup>
    </MudStack>
    <MudPaper Elevation="1" Class="target-table-paper">
        <div class="table-scroll">
            <table class="target-table">
                <thead><tr>
                    <th scope="col"><span class="visually-hidden">Select</span></th>
                    <th scope="col">Target</th><th scope="col">Plan</th><th scope="col">Reason</th>
                    <th scope="col">Last outcome</th><th scope="col">Output</th><th scope="col">Detail</th><th scope="col">Action</th>
                </tr></thead>
                <tbody>
                    @foreach (var group in CollectionPageModel.Groups(_snapshot.Plan))
                    {
                        var selectedInGroup = group.Targets.Count(t => _selection.Contains(t.Id));
                        var groupActive = CollectionPageModel.HasActiveAttempt(group, _snapshot.States);
                        <tr class="target-group-row" @key="group.Kind">
                            <th scope="rowgroup" colspan="8">
                                <span class="activity"><span class="activity-icon">
                                    @if (groupActive)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                    }
                                </span><strong>@group.Kind</strong></span>
                                <span class="target-group-count">@group.Targets.Count targets</span>
                                @if (selectedInGroup > 0)
                                {
                                    <span class="target-group-count">@selectedInGroup selected</span>
                                }
                            </th>
                        </tr>
                        @foreach (var planned in CollectionPageModel.VisibleTargets(group, _snapshot.States, _targetListView))
                        {
                            _snapshot.States.TryGetValue(planned.Id, out var state);
                            <tr class="target-item-row @(_selection.Contains(planned.Id) ? "selected" : "")" @key="planned.Id"
                                @onclick="@(() => _selection.Toggle(planned.Id))" aria-selected="@_selection.Contains(planned.Id)">
                                <td @onclick:stopPropagation="true">
                                    <MudCheckBox T="bool" Dense="true" AriaLabel="@($"Select {planned.Id}")"
                                                 Value="_selection.Contains(planned.Id)"
                                                 ValueChanged="@(selected => SetSelected(planned.Id, selected))" />
                                </td>
                                <td class="target-key">@planned.Id.Key</td>
                                <td><MudChip T="string" Size="Size.Small" Color="@DispositionColor(planned.Disposition)">@planned.Disposition</MudChip></td>
                                <td>@planned.Reason</td>
                                <td><span class="activity"><span class="activity-icon">
                                    @if (CollectionPageModel.IsActive(planned.Id, _snapshot.States))
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                    }
                                </span>@(state?.Outcome ?? "missing")</span></td>
                                <td @onclick:stopPropagation="true">
                                    @if (state?.ManifestPath is { Length: > 0 } marker)
                                    {
                                        <a href="@marker" target="_blank" rel="noopener noreferrer">Output group</a>
                                    }
                                </td>
                                <td>@(state?.Error ?? state?.StaleReason ?? "")</td>
                                <td @onclick:stopPropagation="true">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_markingStale"
                                               OnClick="@(() => MarkStale(planned.Id))">
                                        @(_selection.Count > 0 ? $"Mark {_selection.Count} selected stale" : "Mark stale")
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </MudPaper>
}

@if (Ledger.All().Count > 0)
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Live transfers</MudText>
        <div class="table-scroll">
            <MudTable T="TransferSnapshot" Items="Ledger.All()" Dense="true" Elevation="0">
                <HeaderContent><MudTh>Target</MudTh><MudTh>State</MudTh><MudTh>Bytes</MudTh><MudTh>Expected bytes</MudTh><MudTh>Detail</MudTh></HeaderContent>
                <RowTemplate Context="transfer">
                    <MudTd>@transfer.Target</MudTd><MudTd>@transfer.State</MudTd>
                    <MudTd>@transfer.Bytes.ToString("N0")</MudTd><MudTd>@transfer.ExpectedBytes?.ToString("N0")</MudTd><MudTd>@transfer.Error</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </MudPaper>
}
</MudStack>

@code {
    private CollectionPlanSnapshot? _snapshot;
    private string? _message;
    private string? _error;
    private int _parallelismDraft = Creational.Dataflow.Execution.CollectionParallelism.Default;
    private int _savedParallelism = Creational.Dataflow.Execution.CollectionParallelism.Default;
    private readonly TargetSelection _selection = new();
    private TargetListView _targetListView = TargetListView.All;
    private readonly List<BreadcrumbItem> _breadcrumbs =
        [new("Collections", "/"), new("English Wikipedia", null, true)];
    private bool _markingStale;
    private readonly CancellationTokenSource _refreshStop = new();
    private Task? _refreshTask;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _refreshTask = RefreshLoopAsync();
    }

    private async Task Refresh()
    {
        try
        {
            _snapshot = await Engine.GetRecordedPlanAsync(October2026Collection.Collection, _refreshStop.Token);
            var parallelism = await Settings.GetParallelismAsync(October2026Collection.Collection, _refreshStop.Token);
            if (_parallelismDraft == _savedParallelism) _parallelismDraft = parallelism;
            _savedParallelism = parallelism;
            _error = null;
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            _error = error.Message;
        }
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_refreshStop.Token))
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }

    private async Task MarkStale(TargetId id)
    {
        if (_markingStale) return;
        _markingStale = true;
        var targets = _selection.ActionTargets(id);
        var failures = new List<string>();
        var succeeded = 0;
        try
        {
            foreach (var target in targets)
            {
                try
                {
                    await Repository.MarkStaleAsync(target, "Marked in dashboard", _refreshStop.Token);
                    _selection.MarkSucceeded(target);
                    succeeded++;
                }
                catch (Exception error) when (error is not OperationCanceledException)
                {
                    failures.Add($"{target}: {error.Message}");
                }
            }
            _message = succeeded > 0 ? $"Marked {succeeded} target(s) stale. The plan below shows what would run." : null;
            await Refresh();
            if (failures.Count > 0) _error = $"Could not mark {failures.Count} target(s) stale: {string.Join("; ", failures)}";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _markingStale = false; }
    }

    private void SetSelected(TargetId id, bool selected) => _selection.Set(id, selected);

    private static Color DispositionColor(TargetDisposition disposition) => disposition switch
    {
        TargetDisposition.Current => Color.Success,
        TargetDisposition.Run => Color.Warning,
        TargetDisposition.Blocked => Color.Info,
        TargetDisposition.Failed => Color.Error,
        _ => Color.Default
    };

    private async Task SaveParallelism()
    {
        try
        {
            await Settings.SetParallelismAsync(October2026Collection.Collection, _parallelismDraft, _refreshStop.Token);
            _savedParallelism = _parallelismDraft;
            _message = $"Maximum concurrent targets set to {_savedParallelism}.";
            _error = null;
        }
        catch (Exception error) { _error = error.Message; }
    }

    private async Task StartImport()
    {
        try
        {
            var run = await Coordinator.StartOrGetAsync(October2026Collection.Collection, CancellationToken.None);
            _message = $"Collection import started: {run}";
            await Refresh();
        }
        catch (Exception error) { _error = error.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        _refreshStop.Cancel();
        if (_refreshTask is not null) await _refreshTask;
        _refreshStop.Dispose();
    }
}
