@page "/image-batches/{Id}"
@implements IAsyncDisposable
@using Creational.Dataflow.Images
@inject ThumbnailImportService Imports
@inject IThumbnailBatchManifestStore Manifests

<MudStack Spacing="3">
    <MudBreadcrumbs Items="_breadcrumbs" />
    <MudText Typo="Typo.h4">Image batch</MudText>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_batch is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        @if (_batch.ParentRunId is { } runId)
        {
            <MudButton Href="@($"/image-runs/{runId}")" Variant="Variant.Text" Color="Color.Primary">Back to import run</MudButton>
        }
        <MudPaper Class="pa-4">
            <MudStack Spacing="1">
                <MudText>Selection: @SelectionLabel · images @(_batch.StartOffset + 1)–@_batch.EndOffset · width @_batch.Width px</MudText>
                @if (_batch.ManifestPath is not null)
                {
                    <MudText>Status: @_batch.Status · @_finished.ToString("N0") of @_batch.RequestedCount.ToString("N0") finished · @_batch.CopiedImages copied · @_batch.SkippedImages already present · @_batch.FailedImages failed</MudText>
                }
                else
                {
                    <MudText>Status: @_batch.Status · @_finished.ToString("N0") of @_batch.RequestedCount.ToString("N0") finished · @_batch.FailedJobs failed child jobs</MudText>
                }
                <MudProgressLinear Color="Color.Primary" Value="@Progress" />
                @if (_batch.Error is not null)
                {
                    <MudText Color="Color.Error">@_batch.Error</MudText>
                }
            </MudStack>
        </MudPaper>
        @if (_batch.ManifestPath is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudText Typo="Typo.h6">Images</MudText>
                <MudToggleGroup T="ThumbnailBatchFilter" @bind-Value="_viewFilter" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary" CheckMark="true" FixedContent="true" aria-label="Show images">
                    <MudToggleItem Value="ThumbnailBatchFilter.All" Text="All" />
                    <MudToggleItem Value="ThumbnailBatchFilter.InProgress" Text="In progress" />
                    <MudToggleItem Value="ThumbnailBatchFilter.Skipped" Text="Skipped" />
                    <MudToggleItem Value="ThumbnailBatchFilter.Pending" Text="Pending" />
                </MudToggleGroup>
            </MudStack>
            @if (FilteredRows.Count == 0)
            {
                <MudText Color="Color.Secondary">No images match this view.</MudText>
            }
            else
            {
                <MudTable Items="FilteredRows" Dense="true" Hover="true" RowsPerPage="20">
                    <HeaderContent><MudTh>Position</MudTh><MudTh>File</MudTh><MudTh>Thumbnail</MudTh><MudTh>Imageinfo</MudTh><MudTh>Bytes copied</MudTh><MudTh>Details</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Position">@(context.Offset + 1)</MudTd>
                        <MudTd DataLabel="File">@context.Title</MudTd>
                        <MudTd DataLabel="Thumbnail">@CopyLabel(context)</MudTd>
                        <MudTd DataLabel="Imageinfo"><ImageMetadataStatus @key="context.Title" Title="@context.Title" /></MudTd>
                        <MudTd DataLabel="Bytes copied">@context.Bytes?.ToString("N0")</MudTd>
                        <MudTd DataLabel="Details">@context.Error</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            }
        }
        else
        {
            <MudText Typo="Typo.h6">Child jobs</MudText>
            @if (_jobs.Count == 0)
            {
                <MudText Color="Color.Secondary">The first child job will appear when scheduling starts.</MudText>
            }
            else
            {
                <MudTable Items="_jobs" Dense="true" Hover="true" RowsPerPage="10">
                    <HeaderContent><MudTh>Range</MudTh><MudTh>Images</MudTh><MudTh>Status</MudTh><MudTh>Created</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Range"><a href="@($"/image-jobs/{context.Id}")">@((context.StartOffset ?? 0) + 1)–@((context.StartOffset ?? 0) + context.Titles.Length)</a></MudTd>
                        <MudTd DataLabel="Images">@context.Titles.Length</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager /></PagerContent>
                </MudTable>
            }
        }
    }
</MudStack>

@code {
    [Parameter] public string Id { get; set; } = "";
    private ThumbnailImportBatch? _batch;
    private IReadOnlyList<Creational.Dataflow.Images.ThumbnailImportJob> _jobs = [];
    private ThumbnailBatchManifest? _manifest;
    private string? _manifestPath;
    private IReadOnlyList<ThumbnailBatchViewItem> _rows = [];
    private ThumbnailBatchFilter _viewFilter = ThumbnailBatchFilter.All;
    private string? _error;
    private CancellationTokenSource? _stop;
    private int _finished => _batch is null ? 0 : _batch.NextOffset - _batch.StartOffset;
    private double Progress => _batch is null ? 0 : 100.0 * _finished / _batch.RequestedCount;
    private IReadOnlyList<ThumbnailBatchViewItem> FilteredRows => ThumbnailBatchView.Filter(_rows, _viewFilter);
    private static string CopyLabel(ThumbnailBatchViewItem row) => row.WorkStage switch
    {
        ThumbnailBatchWorkStage.Metadata => "Checking imageinfo",
        ThumbnailBatchWorkStage.Copy => "Processing thumbnail",
        _ => row.CopyStatus
    };
    private string SelectionLabel => _batch?.Selection.Kind == ImageSelectionKind.OttBranch
        ? $"OTT {_batch.Selection.Value}" : $"Wikipedia: {_batch?.Selection.Value}";
    private readonly List<BreadcrumbItem> _breadcrumbs =
        [new("Collections", "/"), new("Image jobs", "/image-jobs"), new("Batch", null, true)];

    protected override async Task OnInitializedAsync()
    {
        _stop = new CancellationTokenSource();
        await RefreshAsync(_stop.Token);
        if (_batch?.Status is "pending" or "running") _ = PollAsync(_stop.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(5), ct);
                await InvokeAsync(async () => { await RefreshAsync(ct); StateHasChanged(); });
                if (_batch?.Status is not ("pending" or "running")) break;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            _batch = await Imports.GetBatchAsync(Id, ct);
            if (_batch is null) { _error = "Image batch was not found."; return; }
            if (_batch.ManifestPath is null)
                _jobs = await Imports.ListBatchJobsAsync(Id, ct);
            else
            {
                if (_manifestPath != _batch.ManifestPath)
                {
                    _manifest = await Manifests.ReadAsync(_batch.ManifestPath, ct);
                    if (_manifest.BatchId != _batch.Id || _manifest.Images.Length != _batch.RequestedCount)
                        throw new InvalidDataException("Image batch manifest does not match this batch.");
                    _manifestPath = _batch.ManifestPath;
                }
                var outcomes = await Imports.ListBatchItemsAsync(Id, ct);
                _rows = ThumbnailBatchView.Build(_manifest!, _batch.StartOffset, outcomes,
                    Imports.GetBatchActivity(Id));
            }
            _error = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
    }

    public ValueTask DisposeAsync()
    {
        _stop?.Cancel();
        _stop?.Dispose();
        return ValueTask.CompletedTask;
    }
}
