@page "/image-jobs"
@implements IAsyncDisposable
@using Creational.Dataflow.Images
@inject ThumbnailImportService Imports
@inject ResizeSweepService Resizes

<MudStack Spacing="3">
    <MudBreadcrumbs Items="_breadcrumbs" />
    <MudText Typo="Typo.h4">Image jobs</MudText>
    <MudButton Href="/images" Variant="Variant.Outlined" Color="Color.Primary">Preview and schedule images</MudButton>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    @if (!_loaded)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Derived thumbnails</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_scheduling"
                       OnClick="StartResizeAsync">Run full resize sweep</MudButton>
        </MudStack>
        <MudText Color="Color.Secondary">Derive 20, 40, 60, and 120px WebP images from every imported 250px image.</MudText>
        @if (_resizeRuns.Count > 0)
        {
            <MudTable Items="_resizeRuns" Dense="true" Hover="true" RowsPerPage="10">
                <HeaderContent><MudTh>Created</MudTh><MudTh>250px images scanned</MudTh><MudTh>Generated</MudTh><MudTh>Skipped</MudTh><MudTh>Failed</MudTh><MudTh>Status</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Created"><a href="@($"/resize-runs/{context.Id}")">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</a></MudTd>
                    <MudTd DataLabel="250px images scanned">@context.Processed.ToString("N0")</MudTd>
                    <MudTd DataLabel="Generated">@context.Generated.ToString("N0")</MudTd>
                    <MudTd DataLabel="Skipped">@context.Skipped.ToString("N0")</MudTd>
                    <MudTd DataLabel="Failed">@context.Failed.ToString("N0")</MudTd>
                    <MudTd DataLabel="Status">@context.Status @context.Error</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
        <MudText Typo="Typo.h6">Import runs</MudText>
        @if (_runs.Count == 0)
        {
            <MudText Color="Color.Secondary">No entire-selection imports have been scheduled yet.</MudText>
        }
        else
        {
            <MudTable Items="_runs" Dense="true" Hover="true" RowsPerPage="10">
                <HeaderContent><MudTh>Created</MudTh><MudTh>Selection</MudTh><MudTh>Images</MudTh><MudTh>Progress</MudTh><MudTh>Status</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Created"><a href="@($"/image-runs/{context.Id}")">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</a></MudTd>
                    <MudTd DataLabel="Selection">@SelectionLabel(context.Selection)</MudTd>
                    <MudTd DataLabel="Images">@context.TotalImages.ToString("N0")</MudTd>
                    <MudTd DataLabel="Progress">@context.NextBatchIndex / @context.BatchCount batches</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
        <MudText Typo="Typo.h6">Batches</MudText>
        @if (_batches.Count == 0)
        {
            <MudText Color="Color.Secondary">No image batches have been scheduled yet.</MudText>
        }
        else
        {
            <MudTable Items="_batches" Dense="true" Hover="true" RowsPerPage="10">
                <HeaderContent>
                    <MudTh>Created</MudTh><MudTh>Selection</MudTh><MudTh>Range</MudTh><MudTh>Progress</MudTh><MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Created"><a href="@($"/image-batches/{context.Id}")">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</a></MudTd>
                    <MudTd DataLabel="Selection">@SelectionLabel(context.Selection)</MudTd>
                    <MudTd DataLabel="Range">@((context.StartOffset + 1).ToString("N0"))–@context.EndOffset.ToString("N0")</MudTd>
                    <MudTd DataLabel="Progress">@((context.NextOffset - context.StartOffset).ToString("N0")) / @context.RequestedCount.ToString("N0")</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
        <MudText Typo="Typo.h6">Individual jobs</MudText>
        @if (_standalone.Count == 0)
        {
            <MudText Color="Color.Secondary">No individual image jobs have been started yet.</MudText>
        }
        else
        {
            <MudTable Items="_standalone" Dense="true" Hover="true" RowsPerPage="10">
                <HeaderContent><MudTh>Created</MudTh><MudTh>File</MudTh><MudTh>Images</MudTh><MudTh>Status</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Created"><a href="@($"/image-jobs/{context.Id}")">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</a></MudTd>
                    <MudTd DataLabel="File">@context.Titles[0]</MudTd>
                    <MudTd DataLabel="Images">@context.Titles.Length</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<ThumbnailImportRun> _runs = [];
    private IReadOnlyList<ResizeSweepRun> _resizeRuns = [];
    private IReadOnlyList<ThumbnailImportBatch> _batches = [];
    private IReadOnlyList<Creational.Dataflow.Images.ThumbnailImportJob> _standalone = [];
    private bool _loaded;
    private bool _scheduling;
    private string? _error;
    private CancellationTokenSource? _stop;
    private readonly List<BreadcrumbItem> _breadcrumbs =
        [new("Collections", "/"), new("Image jobs", null, true)];

    protected override async Task OnInitializedAsync()
    {
        _stop = new CancellationTokenSource();
        await RefreshAsync(_stop.Token);
        _ = PollAsync(_stop.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(10), ct);
                await InvokeAsync(async () => { await RefreshAsync(ct); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        try
        {
            _runs = await Imports.ListRunsAsync(int.MaxValue, ct);
            _resizeRuns = await Resizes.ListAsync(20, ct);
            _batches = (await Imports.ListBatchesAsync(int.MaxValue, ct))
                .Where(x => x.ParentRunId is null).ToArray();
            _standalone = await Imports.ListStandaloneJobsAsync(int.MaxValue, ct);
            _error = null;
            _loaded = true;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception error) { _error = error.Message; }
    }

    private async Task StartResizeAsync()
    {
        if (_scheduling || _stop is null) return;
        _scheduling = true;
        try
        {
            await Resizes.RequestAsync(_stop.Token);
            await RefreshAsync(_stop.Token);
        }
        catch (Exception error) { _error = error.Message; }
        finally { _scheduling = false; }
    }

    private static string SelectionLabel(ImageSelection selection) => selection.Kind == ImageSelectionKind.OttBranch
        ? $"OTT {selection.Value}" : $"Wikipedia: {selection.Value}";

    public ValueTask DisposeAsync()
    {
        _stop?.Cancel();
        _stop?.Dispose();
        return ValueTask.CompletedTask;
    }
}
