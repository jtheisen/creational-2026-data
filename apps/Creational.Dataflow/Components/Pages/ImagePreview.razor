@page "/images"
@using Creational.Dataflow.Images
@inject ImageCatalog Catalog
@inject IImageInfoStore Metadata
@inject ThumbnailImportService ThumbnailImports
@inject NavigationManager Navigation

<MudStack Spacing="3">
    <MudBreadcrumbs Items="_breadcrumbs" />
    <MudText Typo="Typo.h4">Image preview</MudText>
    <MudButton Href="/image-jobs" Variant="Variant.Outlined" Color="Color.Primary">Image jobs</MudButton>
    <MudText Color="Color.Secondary">
        Enter an OTT ID to inspect its descendant branch, or an English Wikipedia article URL.
        OTT links are candidate exact-name matches, not confirmed taxon identities.
    </MudText>
    <MudPaper Class="pa-5" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
            <MudTextField T="string" Label="OTT ID or Wikipedia article URL" @bind-Value="_input"
                          Variant="Variant.Outlined" Placeholder="691846 or https://en.wikipedia.org/wiki/Gadus_morhua"
                          FullWidth="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" OnClick="SearchAsync">Preview</MudButton>
        </MudStack>
    </MudPaper>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="@(_loading ? "preview-loading" : "preview-loading preview-loading-idle")" aria-live="polite">
        <span class="activity-icon">
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
        </span>
        <MudText>@(_loading ? "Preparing the catalog and resolving visible images…" : "")</MudText>
    </MudStack>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    @if (_page is not null)
    {
        <MudStack Row="true" Spacing="2">
            <MudPaper Class="pa-4"><MudText Typo="Typo.h5">@_page.PageCount.ToString("N0")</MudText><MudText>Wikipedia pages</MudText></MudPaper>
            <MudPaper Class="pa-4"><MudText Typo="Typo.h5">@_page.CandidateCount.ToString("N0")</MudText><MudText>candidate files</MudText></MudPaper>
            <MudPaper Class="pa-4"><MudText Typo="Typo.h5">@_page.UnresolvedCount.ToString("N0")</MudText><MudText>unresolved references</MudText></MudPaper>
            @if (_page.KnownOriginalBytes is { } knownBytes)
            {
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5">@((knownBytes / 1073741824.0).ToString("N2")) GiB</MudText>
                    <MudText>known original size</MudText>
                    <MudText Typo="Typo.caption">@_page.MetadataResolvedCount?.ToString("N0") images · @_page.MetadataMissingCount?.ToString("N0") missing · @_page.MetadataAmbiguousCount?.ToString("N0") ambiguous · @_page.MetadataExcludedCount?.ToString("N0") other media</MudText>
                </MudPaper>
            }
        </MudStack>
        @if (_page.KnownOriginalBytes is null)
        {
            <MudAlert Severity="Severity.Info">Original file-size totals will appear after the image metadata import. A 330-pixel thumbnail transfer would be smaller; its size is not yet known.</MudAlert>
        }
        @if (_page.UnresolvedCount > 0)
        {
            <MudAlert Severity="Severity.Info">Unresolved markup references are counted but cannot be shown as image files yet.</MudAlert>
        }
        @if (_metadataError is not null)
        {
            <MudAlert Severity="Severity.Warning">Thumbnail and license metadata could not be loaded: @_metadataError</MudAlert>
        }
        @if (_page.CandidateCount == 0)
        {
            <MudAlert Severity="Severity.Info">No resolvable image files were found for this selection.</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Import 250px thumbnails</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Disabled="@(_loading || _importing || _page.Items.Count == 0)" OnClick="ImportVisibleAsync">
                            Import this page (@_page.Items.Count)
                        </MudButton>
                        <MudNumericField T="int" Label="Start at image" @bind-Value="_batchStart"
                                         Min="1" Max="@_page.CandidateCount" Variant="Variant.Outlined" Style="max-width: 190px" />
                        <MudNumericField T="int" Label="Images to schedule" @bind-Value="_batchCount"
                                         Min="1" Max="1000" Variant="Variant.Outlined" Style="max-width: 190px" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_loading || _importing || _page.Items.Count == 0 || _batchCount is < 1 or > 1000 || _batchStart < 1 || _batchStart > _page.CandidateCount)" OnClick="ImportBatchAsync">
                            @(_importing ? "Scheduling…" : "Schedule batch")
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption">
                        @if (_batchCount is >= 1 and <= 1000 && _batchStart >= 1 && _batchStart <= _page.CandidateCount)
                        {
                            <span>Schedule images @BatchStart.ToString("N0")–@BatchEnd.ToString("N0") of @_page.CandidateCount.ToString("N0") in this selection. One action can schedule up to 1,000; copying continues after you leave.</span>
                        }
                        else
                        {
                            <span>Enter a starting image within this selection and a count from 1 to 1,000.</span>
                        }
                    </MudText>
                </MudStack>
            </MudPaper>
            <MudGrid Spacing="2">
                @foreach (var candidate in _page.Items)
                {
                    _metadata.TryGetValue(candidate.FileTitle, out var info);
                    <MudItem xs="12" sm="6" md="4" lg="3" @key="candidate.FileTitle">
                        <MudCard Class="image-card">
                            @if (info?.ThumbnailUrl is { } thumbnail)
                            {
                                <img class="image-thumb" src="@thumbnail" alt="Preview of @candidate.FileTitle" loading="lazy" />
                            }
                            else
                            {
                                <div class="image-thumb image-placeholder">No thumbnail</div>
                            }
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle2" Class="image-filename">@candidate.FileTitle</MudText>
                                <MudStack Row="true" Spacing="1" Class="my-2">
                                    <MudChip T="string" Size="Size.Small" Color="@(info?.NeedsRightsReview == false ? Color.Primary : Color.Warning)">
                                        @(info?.License ?? "Rights review")
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@candidate.SourceKind</MudChip>
                                </MudStack>
                                @if (info?.Attribution is { } attribution)
                                {
                                    <MudText Typo="Typo.caption">@attribution</MudText>
                                }
                                @if (info?.OriginalBytes is { } bytes)
                                {
                                    <MudText Typo="Typo.caption">Original: @((bytes / 1048576.0).ToString("N1")) MiB</MudText>
                                }
                                <MudText Typo="Typo.caption">
                                    From <a href="@ArticleUrl(candidate.ArticleTitle)" target="_blank" rel="noopener noreferrer">@candidate.ArticleTitle</a>
                                    @if (info?.DescriptionUrl is { } description)
                                    {
                                        <span> · <a href="@description" target="_blank" rel="noopener noreferrer">File page</a></span>
                                    }
                                    @if (info?.LicenseUrl is { } licenseUrl)
                                    {
                                        <span> · <a href="@licenseUrl" target="_blank" rel="noopener noreferrer">License</a></span>
                                    }
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Outlined" Disabled="@(_loading || _pageNumber == 1)" OnClick="PreviousAsync">Previous</MudButton>
                <MudText>Page @_pageNumber of @((int)Math.Ceiling(_page.CandidateCount / (double)PageSize))</MudText>
                <MudButton Variant="Variant.Outlined" Disabled="@(_loading || _pageNumber * PageSize >= _page.CandidateCount)" OnClick="NextAsync">Next</MudButton>
            </MudStack>
        }
    }
</MudStack>

@code {
    private const int PageSize = 24;
    private string _input = "";
    private ImageSelection? _selection;
    private ImageCatalogPage? _page;
    private IReadOnlyDictionary<string, ImageMetadata> _metadata = new Dictionary<string, ImageMetadata>();
    private string? _error;
    private string? _metadataError;
    private bool _loading;
    private bool _importing;
    private int _batchStart = 1;
    private int _batchCount = 100;
    private int _pageNumber = 1;
    private int BatchOffset => _batchStart - 1;
    private int BatchStart => _batchStart;
    private int BatchEnd => _page is null ? BatchOffset : Math.Min(_page.CandidateCount, BatchOffset + _batchCount);
    private readonly List<BreadcrumbItem> _breadcrumbs =
        [new("Collections", "/"), new("Image preview", null, true)];

    private async Task SearchAsync()
    {
        try
        {
            _selection = ImageSelection.Parse(_input);
            _pageNumber = 1;
            _batchStart = 1;
            await LoadPageAsync();
        }
        catch (ArgumentException error) { _error = error.Message; }
    }

    private async Task PreviousAsync() { _pageNumber--; _batchStart = (_pageNumber - 1) * PageSize + 1; await LoadPageAsync(); }
    private async Task NextAsync() { _pageNumber++; _batchStart = (_pageNumber - 1) * PageSize + 1; await LoadPageAsync(); }

    private async Task LoadPageAsync()
    {
        if (_selection is null) return;
        _loading = true;
        _error = null;
        _metadataError = null;
        try
        {
            _page = await Catalog.QueryAsync(_selection, (_pageNumber - 1) * PageSize, PageSize, CancellationToken.None);
            _metadata = new Dictionary<string, ImageMetadata>();
            await InvokeAsync(StateHasChanged);
            try
            {
                var info = await Metadata.EnsureAsync(_page.Items, CancellationToken.None);
                _metadata = info.ToDictionary(x => x.Key, x => x.Value.ToDisplay(330), StringComparer.Ordinal);
            }
            catch (Exception error) { _metadataError = error.Message; }
        }
        catch (Exception error) { _error = error.Message; _page = null; }
        finally { _loading = false; }
    }

    private static string ArticleUrl(string title) =>
        "https://en.wikipedia.org/wiki/" + Uri.EscapeDataString(title.Replace(' ', '_'));

    private async Task ImportVisibleAsync()
    {
        if (_page is null || _selection is null || _importing) return;
        _importing = true;
        _error = null;
        try
        {
            var id = await ThumbnailImports.CreateBatchAsync(_selection,
                (_pageNumber - 1) * PageSize, _page.Items.Count, CancellationToken.None);
            Navigation.NavigateTo($"/image-batches/{id}");
        }
        catch (Exception error) { _error = error.Message; }
        finally { _importing = false; }
    }

    private async Task ImportBatchAsync()
    {
        if (_selection is null || _page is null || _importing || _batchCount is < 1 or > 1000 ||
            _batchStart < 1 || _batchStart > _page.CandidateCount) return;
        _importing = true;
        _error = null;
        try
        {
            var count = Math.Min(_batchCount, _page.CandidateCount - BatchOffset);
            var id = await ThumbnailImports.CreateBatchAsync(_selection, BatchOffset, count, CancellationToken.None);
            Navigation.NavigateTo($"/image-batches/{id}");
        }
        catch (Exception error) { _error = error.Message; }
        finally { _importing = false; }
    }
}
